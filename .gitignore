# --- Unreal Engine Plugin Exclusions ---
# Exclude compiled binaries and build artifacts
Binaries/
Intermediate/

# Exclude generated project files (if you develop the plugin inside a project)
DerivedDataCache/
Saved/
Build/

# --- IDE and System Files ---
# Visual Studio
.vs/
*.sln
*.vcxproj
*.filters
*.user

# VS Code
.vscode/

# Rider
.idea/

# Mac system files
.DS_Store

# --- Temporary/Backup Files ---
*.bak
*.tmp
*.patch